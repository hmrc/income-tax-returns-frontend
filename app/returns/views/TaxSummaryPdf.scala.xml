        @import returns.models.liabilitycalculation.viewmodels.TaxDueSummaryViewModel
        @import returns.models.liabilitycalculation.viewmodels.PDFCalculationViewModel

        @this()

        @(viewModel: TaxDueSummaryViewModel, pageData: PDFCalculationViewModel, listOfNames: Seq[(String,String)], lang: String)(implicit messages: Messages)

        <!-- example for a simple fo file. At the beginning the page layout is set.
          Below fo:root there is always
        - a single fo:layout-master-set which defines one or more page layouts
        - an optional fo:declarations
        - and a sequence of one or more fo:page-sequences containing the text and formatting instructions
        -->

<fo:root
        xmlns:fo="http://www.w3.org/1999/XSL/Format"
        xmlns:fox="http://xmlgraphics.apache.org/fop/extensions"
        font-family="OpenSans"
        font-size="10.5pt"
        line-height="12pt"
        xml:lang="@lang"
>

    <fo:layout-master-set>
        <!-- fo:layout-master-set defines in its children the page layout:
             the pagination and layout specifications
            - page-masters: have the role of describing the intended subdivisions
                             of a page and the geometry of these subdivisions
                            In this case there is only a simple-page-master which defines the
                            layout for all pages of the text
        -->

        <!-- layout for the first page -->
        <fo:simple-page-master master-name="first"
                               page-height="29.7cm"
                               page-width="21cm"
                               margin-top="0.5cm"
                               margin-bottom="0.5cm"
                               margin-left="2.2cm"
                               margin-right="2.2cm">
            <fo:region-body margin-top="0.7cm"/>
            <fo:region-before extent="0.5cm"/>
            <fo:region-after extent="0.6cm"/>
        </fo:simple-page-master>

        <!-- layout for the other pages -->
        <fo:simple-page-master master-name="rest"
                               page-height="29.7cm"
                               page-width="21cm"
                               margin-top="0.5cm"
                               margin-bottom="0.5cm"
                               margin-left="2.2cm"
                               margin-right="2.2cm">
            <fo:region-body margin-top="0.5cm"/>
            <fo:region-before extent="0.5cm"/>
            <fo:region-after extent="0.6cm"/>
        </fo:simple-page-master>

        <fo:page-sequence-master master-name="basicPSM">
            <fo:repeatable-page-master-alternatives>
                <fo:conditional-page-master-reference master-reference="first"
                                                      page-position="first"/>
                <fo:conditional-page-master-reference master-reference="rest"
                                                      page-position="rest"/>
                <!-- recommended fallback procedure -->
                <fo:conditional-page-master-reference master-reference="rest"/>
            </fo:repeatable-page-master-alternatives>
        </fo:page-sequence-master>

    </fo:layout-master-set>
    <!-- end: defines page layout -->




    <!-- Document metadata -->
    <fo:declarations>
        <x:xmpmeta xmlns:x="adobe:ns:meta/">
            <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
                <rdf:Description xmlns:dc="http://purl.org/dc/elements/1.1/">
                    <dc:title>
                        @Messages("label.your_tax_calculation_letter")
                    </dc:title>
                </rdf:Description>
            </rdf:RDF>
        </x:xmpmeta>
    </fo:declarations>
    <!-- end Document metadata -->

    <fo:bookmark-tree>
        <fo:bookmark internal-destination="heading-h1-1">
            <fo:bookmark-title>@Messages("label.your_tax_calculation_letter")</fo:bookmark-title>
            <fo:bookmark internal-destination="heading-h1-1-h2-1">
                <fo:bookmark-title>@messages("your_tax_calculation_letter")</fo:bookmark-title>
            </fo:bookmark>
        </fo:bookmark>
    </fo:bookmark-tree>

    <!-- start page-sequence
         here comes the text (contained in flow objects)
         the page-sequence can contain different fo:flows
         the attribute value of master-name refers to the page layout
         which is to be used to layout the text contained in this
         page-sequence-->
    <fo:page-sequence master-reference="basicPSM">

        <!-- footer -->
        <fo:static-content role="artifact" flow-name="xsl-region-after">
            <fo:block font-size="9pt"
                      line-height="14pt">
                <!-- date -->
                <fo:block text-align="end">
                    @Messages("label.hmrc_date", java.time.LocalDate.now().format(java.time.format.DateTimeFormatter.ofPattern("MM / YY")))
                </fo:block>
            </fo:block>
        </fo:static-content>
        <!-- end footer -->
        <fo:flow flow-name="xsl-region-body">

            <!-- logo and heading -->
            <fo:block role="Div"
                      border-bottom-style="solid"
                      border-bottom-width="4px"
                      border-bottom-color="#3F66B1"
                      padding-after="6px">

                <fo:block role="Div"
                          padding-start="14px">

                    <fo:external-graphic
                            src="url('file:pdf/logo/govuk.png')"
                            content-height="scale-to-fit"
                            content-width="6cm"
                            role="Artifact"
                            fox:alt-text="@Messages("label.alt.hmrc_logo")"/>

                    <fo:block role="P"
                              font-size="22pt"
                              font-weight="bold"
                              line-height="24pt"
                              space-before="-56px"
                              padding-start="14px"
                              linefeed-treatment="preserve">
                        @Messages("label.self-assessment.heading")
                    </fo:block>

                </fo:block>

            </fo:block>

            <!-- end logo and heading -->
<!--main text  -->
            <fo:block padding-before="12px"
                      padding-after="6px"
                      text-align="right">
                @Messages("label.unique.taxpayer.reference", pageData.utr)
            </fo:block>

            <fo:block padding-after="6px"
                      text-align="right"
                      font-weight="bold"
                      font-family="OpenSans-Bold">
                @Messages("label.your_tax_calculation_letter.returnStatus", pageData.returnStatus)
            </fo:block>

            <fo:block role="H2"
                      font-size="14pt"
                      text-align="left"
                      padding-before="20px"
                      padding-after="6px"
                      font-weight="bold"
                      id="heading-h2-1">
                @pageData.nameLine
            </fo:block>


            <fo:block role="H1"
                      font-size="28pt"
                      text-align="left"
                      padding-before="20px"
                      padding-after="30px"
                      font-family="OpenSans-Bold"
                      font-weight="bold"
                      id="heading-h1-1">
                @Messages("label.your_tax_calculation_letter.h1")
            </fo:block>


            <fo:table table-layout="fixed" width="100%">
                <fo:table-column column-width="45pt"/>
                <fo:table-column column-width="proportional-column-width(1)"/>

                <fo:table-body>
                    <fo:table-row>

                        <fo:table-cell display-align="center">
                            <fo:block>
                                <fo:external-graphic
                                        src="url('file:pdf/logo/warning-icon.png')"
                                        content-width="35pt"
                                        content-height="35pt"
                                        scaling="uniform"/>
                            </fo:block>
                        </fo:table-cell>

                        <fo:table-cell display-align="center">
                            <fo:block font-weight="bold"
                                      font-family="OpenSans-Bold">
                                @Messages("label.your_tax_calculation_letter.warning")
                            </fo:block>
                        </fo:table-cell>

                    </fo:table-row>
                </fo:table-body>
            </fo:table>

            <fo:block role="H1"
                      font-family="OpenSans-Bold"
                      font-weight="bold"
                      font-size="14pt"
                      padding-after="20px"
                      padding-before="20px">
                @pageData.incomeReceivedHeading
            </fo:block>


            <fo:table table-layout="fixed" width="100%">
                <fo:table-column column-width="50%"/>
                <fo:table-column column-width="50%"/>

                <fo:table-body>
                    @for(((firstName, lastName), index) <- listOfNames.zipWithIndex) {
                    <fo:table-row
                            border-bottom="0.5pt solid #BFBFBF">

                        <fo:table-cell
                                padding-right="10pt"
                                padding-top="6pt"
                                padding-bottom="6pt">
                            <fo:block font-weight="@if(index == 0 || index == listOfNames.size - 1) {bold} else {normal}">
                                @firstName
                            </fo:block>
                        </fo:table-cell>

                        <fo:table-cell
                                padding-left="10pt"
                                padding-top="6pt"
                                padding-bottom="6pt"
                                text-align="right">
                            <fo:block>
                                @lastName
                            </fo:block>
                        </fo:table-cell>

                    </fo:table-row>
                    }
                </fo:table-body>
            </fo:table>





<!--            end of main text -->


        </fo:flow> <!-- closes the flow element-->
    </fo:page-sequence> <!-- closes the page-sequence -->
</fo:root>